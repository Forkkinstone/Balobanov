import math
from typing import Union, List

class Angle:
    def __init__(self, value: Union[float, int] = 0) -> None:
        try:
            self.radians = float(value)
        except (TypeError, ValueError):
                raise ValueError(f"Некорректное значение угла: {e}")

    @property
    def degrees(self) -> float:
        # получить угол в градусах
        return math.degrees(self.radians)

    @degrees.setter
    def degrees(self, value: float):
        # установить угол в градусах
        self.radians = math.radians(float(value))

    def normalized(self) -> float:
        # нормализация угла к диапазону [0, 2pi)
        return self.radians % (2 * math.pi)

    # операции сравнения с учетом 2*Pi*N + x = x

    def __eq__(self, other) -> bool:
        # проверка равенства углов с учетом нормализации
        if isinstance(other, Angle):
            val = other.normalized()
        elif isinstance(other, (int, float)):
            val = float(other) % (2 * math.pi)
        else:
            return NotImplemented
        return math.isclose(self.normalized(), val, abs_tol=1e-9)

    def __lt__(self, other) -> bool:
        # проверяет, меньше ли текущий угол другого
        val = other.normalized() if isinstance(other, Angle) else float(other) % (2 * math.pi)
        return self.normalized() < val

    def __le__(self, other) -> bool:
        # проверяет, меньше или равен ли текущий угол другому
        return self < other or self == other

    # арифметические операции

    def __add__(self, other):
        val = other.radians if isinstance(other, Angle) else float(other)
        return Angle(self.radians + val)

    def __radd__(self, other):
        return self + other

    def __sub__(self, other):
        val = other.radians if isinstance(other, Angle) else float(other)
        return Angle(self.radians - val)

    def __rsub__(self, other):
        return Angle(float(other) - self.radians)

    def __mul__(self, other):
        return Angle(self.radians * float(other))

    def __rmul__(self, other):
        return self * other

    def __truediv__(self, other):
        return Angle(self.radians / float(other))

    # преобразования типов

    def __float__(self): return float(self.radians)

    def __int__(self): return int(self.radians)

    def __str__(self):
        return f"{self.degrees:.1f}°"

    def __repr__(self):
        return f"Angle({self.radians:.4f})"


class AngleRange:
    def __init__(self, start, end, include_start = True, include_end = False) -> None:
        def get_val(x): return float(x) % (2 * math.pi)

        self.start = get_val(start)
        self.end = get_val(end)
        self.inc_start = include_start
        self.inc_end = include_end

    @property
    def length(self) -> float:
        # длина промежутка в радианах
        # работает и для обычных, и для 'обернутых' (через 0) промежутков
        diff = (self.end - self.start) % (2 * math.pi)
        if diff == 0 and self.start == self.end and not (self.inc_start and self.inc_end):
            return 0.0
        return diff if diff != 0 else 0.0

    def __abs__(self): return self.length()

    def __contains__(self, item):
        # проверка вхождения угла или другого промежутка
        if isinstance(item, AngleRange):
            return (item.start in self) and (item.end in self) and (item.length <= self.length)

        val = float(item) % (2 * math.pi)

        if self.inc_start and math.isclose(val, self.start, abs_tol=1e-9): return True
        if self.inc_end and math.isclose(val, self.end, abs_tol=1e-9): return True

        if self.start <= self.end:
            return self.start <= val <= self.end
        else:
            return val > self.start or val < self.end


    def __eq__(self, other):
        # проверяет эквивалентность двух промежутков
        if not isinstance(other, AngleRange): return False
        return (math.isclose(self.start, other.start) and
                math.isclose(self.end, other.end) and
                self.inc_start == other.inc_start and
                self.inc_end == other.inc_end)

    def __lt__(self, other):
        """
        сравнение промежутков (для сортировки)
        логика: сначала сравниваю start, если равны — сравниваю end
        """
        if not isinstance(other, AngleRange):
            return NotImplemented

        if math.isclose(self.start, other.start, abs_tol=1e-9):
            return self.end < other.end

        return self.start < other.start

    def __add__(self, other) -> List['AngleRange']:
        # объединение промежутков
        if not isinstance(other, AngleRange):
            raise TypeError("Можно складывать только с AngleRange")

        if not self.is_intersect(other):
            return [self, other]

        if other in self: return [self]
        if self in other: return [other]

        new_start = self.start
        new_end = self.end

        if other.start in self:
            new_end = other.end

        elif self.start in other:
            new_start = other.start

        return [AngleRange(new_start, new_end, self.inc_start or other.inc_start, self.inc_end or other.inc_end)]

    def is_intersect(self, other):
        return (other.start in self) or (other.end in self) or (self.start in other)

    def __sub__(self, other) -> List['AngleRange']:
        # вычитание промежутков (self - other)
        if not isinstance(other, AngleRange):
            raise TypeError("Можно вычитать только AngleRange")

        if not self.is_intersect(other):
            return [self]

        if self in other:
            return []

        if other.start in self and other.end in self:
            r1 = AngleRange(self.start, other.start, self.inc_start, not other.inc_start)
            r2 = AngleRange(other.end, self.end, not other.inc_end, self.inc_end)
            return [r1, r2]

        if self.start in other:
            return [AngleRange(other.end, self.end, not other.inc_end, self.inc_end)]

        if self.end in other:
            return [AngleRange(self.start, other.start, self.inc_start, not other.inc_start)]

        return [self]

    def __str__(self):
        # строковое представление промежутка для пользователя
        sb, eb = '[' if self.inc_start else '(', ']' if self.inc_end else ')'
        return f"{sb}{math.degrees(self.start):.0f}°, {math.degrees(self.end):.0f}°{eb}"

    def __repr__(self):
        # техническое представление промежутка для разработчика
        return f"AngleRange({self.start:.2f}, {self.end:.2f})"


