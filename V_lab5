                return item
        return None

    def add(self, item: T) -> None:
        items = list(self.get_all())
        if self.get_by_id(item.id) is not None:
            raise ValueError(f"Item with id {item.id} already exists")
        items.append(item)
        self._save_all(items)

    def update(self, item: T) -> None:
        items = list(self.get_all())
        found = False
        for i, existing in enumerate(items):
            if getattr(existing, 'id', None) == getattr(item, 'id', None):
                items[i] = item
                found = True
                break
        if not found:
            raise ValueError(f"Item with id {item.id} not found for update")
        self._save_all(items)

    def delete(self, item: T) -> None:
        items = list(self.get_all())
        id_to_delete = getattr(item, 'id', None)
        items = [i for i in items if getattr(i, 'id', None) != id_to_delete]
        self._save_all(items)


class FileUserRepository(FileDataRepository[User], IUserRepository):
    def __init__(self, file_path: str) -> None:
        super().__init__(file_path, User)

    def get_by_login(self, login: str) -> Optional[User]:
        for user in self.get_all():
            if user.login == login:
                return user
        return None


@dataclass
class AuthSession:
    current_user_id: Optional[int] = None

    def to_dict(self) -> dict:
        return {"current_user_id": self.current_user_id}

    @classmethod
    def from_dict(cls, data: dict) -> "AuthSession":
        return cls(current_user_id=data.get("current_user_id"))


class FileAuthService(IAuthService):
    def __init__(self, session_file: str, user_repo: IUserRepository) -> None:
        self.session_file = Path(session_file)
        self.user_repo = user_repo
        self._session: AuthSession = self._load_session()

    def _load_session(self) -> AuthSession:
        if not self.session_file.exists():
            return AuthSession()
        with open(self.session_file, "r", encoding="utf-8") as f:
            data = json.load(f)
            return AuthSession.from_dict(data)

    def _save_session(self) -> None:
        with open(self.session_file, "w", encoding="utf-8") as f:
            json.dump(self._session.to_dict(), f, indent=4, ensure_ascii=False)

    def sign_in(self, login: str, password: str) -> bool:
        user = self.user_repo.get_by_login(login)
        if user is None:
            return False
        if user.password != password:
            return False
        self._session.current_user_id = user.id
        self._save_session()
        return True

    def sign_out(self) -> None:
        self._session.current_user_id = None
        self._save_session()

    @property
    def is_authorized(self) -> bool:
        return self._session.current_user_id is not None

    @property
    def current_user(self) -> Optional[User]:
        if not self.is_authorized:
            return None
        return self.user_repo.get_by_id(self._session.current_user_id)


def run_demo():
    users_file = "data/users.json"
    session_file = "data/session.json"

    # Очист
    Path(users_file).parent.mkdir(exist_ok=True)
    Path(users_file).unlink(missing_ok=True)
    Path(session_file).unlink(missing_ok=True)

    user_repo = FileUserRepository(users_file)
    auth_service = FileAuthService(session_file, user_repo)

    # 1. Добавление пользователей
    alice = User(id=1, name="Alice", login="alice123", password="pass1", email="alice@example.com")
    bob = User(id=2, name="Bob", login="bob321", password="pass2")
    user_repo.add(alice)
    user_repo.add(bob)

    print("Все пользователи:")
    for u in sorted(user_repo.get_all()):  # сортировка по name
        print(u)
        print("---")

    # 2. Редактирование
    alice.address = "Wonderland"
    user_repo.update(alice)
    print("Alice после обновления:")
    print(user_repo.get_by_id(1))

    # 3. Авторизация
    if auth_service.sign_in("alice123", "pass1"):
        print("\nAlice вошла в систему")
        print("Текущий пользователь:", auth_service.current_user)
    else:
        print("\nНе удалось войти")

    # 4. Смена пользователя
    auth_service.sign_out()
    if auth_service.sign_in("bob321", "pass2"):
        print("\nBob вошёл в систему")
        print("Текущий пользователь:", auth_service.current_user)

    # 5. Имитация перезапуска программы
    del auth_service
    new_auth = FileAuthService(session_file, user_repo)
    print("\nПосле перезапуска (автоавторизация):")
    if new_auth.is_authorized:
        print("Автоматически авторизован:", new_auth.current_user)
    else:
        print("Нет активной сессии")

    # 6. Выход и проверка
    new_auth.sign_out()
    print("\nВыход выполнен. Авторизован?", new_auth.is_authorized)


if __name__ == "__main__":
    run_demo()
