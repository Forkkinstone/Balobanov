def insertion_sort(arr):
    for i in range(1, len(arr)):
        current = arr[i]
        j = i - 1
        while j >= 0 and arr[j] > current:
            arr[j + 1] = arr[j]
            j -= 1
        arr[j + 1] = current
    return arr

user_input = input("Введите через пробел: ")
numbers = list(map(int, user_input.split()))

print("До:", numbers)
print("После:", insertion_sort(numbers.copy()))

