import re

# Хеш-функция: сумма кодов символов % размер таблицы
def simple_hash(word, table_size):
    return sum(ord(char) for char in word) % table_size

# Вставка с линейным пробингом
def insert_with_probing(table, word):
    index = simple_hash(word, len(table))
    original_index = index
    while table[index] is not None:
        if table[index] == word:
            return  # уже есть
        index = (index + 1) % len(table)
        if index == original_index:
            raise Exception("Хеш-таблица переполнена")
    table[index] = word

# Основная функция
def build_hash_table_with_probing(text):
    words = re.findall(r'\b\w+\b', text.lower())
    table_size = len(words) * 2  # запас
    table = [None] * table_size
    for word in words:
        insert_with_probing(table, word)
    return table

# Чтение и запись
with open("input.txt", "r", encoding="utf-8") as f:
    text = f.read()

table = build_hash_table_with_probing(text)

with open("output_lab13.txt", "w", encoding="utf-8") as f:
    for i, word in enumerate(table):
        f.write(f"{i}: {word}\n")

