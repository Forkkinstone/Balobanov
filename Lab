def parse_tree(s):
    def helper():
        nonlocal i
        if i >= len(s) or not s[i].isdigit():
            return None
        num = ''
        while i < len(s) and s[i].isdigit():
            num += s[i]
            i += 1
        node = Node(int(num))
        if i < len(s) and s[i] == '(':
            i += 1
            node.left = helper()
            i += 1
            if i < len(s) and s[i] == '(':
                i += 1
                node.right = helper()
                i += 1
        return node

