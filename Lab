        self.value = value
        self.left = None
        self.right = None

def preorder(node):
    if node:
        result.append(node.value)
        preorder(node.left)
        preorder(node.right)

def inorder(node):
    if node:
        inorder(node.left)
        result.append(node.value)
        inorder(node.right)

def postorder(node):
    if node:
        postorder(node.left)
        postorder(node.right)
        result.append(node.value)

