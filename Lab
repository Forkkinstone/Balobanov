def is_valid_brackets(s):
    stack = []

    # инициализация словаря для сопоставления скобок
    mapping = {')': '('}

    for char in s:
        # если это открывающая скобка
        if char in mapping.values():
            stack.append(char)
        # или если это закрывающая скобка
        elif char in mapping:
            if not stack or stack.pop() != mapping[char]:
                return False # несоответствие или стек пуст
        else:
            # игнорирование если символ не скобка
            pass
    return len(stack) == 0

def tokenize(s):
    # разбивает строку на числа и операторы [токены]
    tokens = []
    number_buffer = []
    # здесь обработка унарного минуса
    s = s.replace('(-', '(0-').replace(' ', '')
    if s.startswith('-'):
        s = '0' + s

    for char in s:
        if char.isdigit() or char == '.':
            number_buffer.append(char)
        else:
            if number_buffer:
                tokens.append(float(''.join(number_buffer)))
                number_buffer = []
            tokens.append(char)
    if number_buffer:
        tokens.append(float(''.join(number_buffer)))
    return tokens

# парсер на основе рекурсивного спуска
class RecursiveParser:
    def __init__(self, tokens):
        self.tokens = tokens
        self.pos = -1
        self.current_token = None
        self.next_token()

    def next_token(self):
        # передвигает указатель на следующий токен
        self.pos += 1
        if self.pos < len(self.tokens):
            self.current_token = self.tokens[self.pos]
        else:
            self.current_token = None # конец выражения

    def parse_factor(self):
        # разбирает 'фактор': число или выражение в скобках
        token = self.current_token
        if isinstance(token, (int, float)):
            self.next_token()
            return token
        elif token == '(':
            self.next_token()
            result = self.parse_expression() # разбор вложенного выражения
            if self.current_token != ')':
                raise ValueError('Ожидалась закрывающая скобка ")"')
            self.next_token()
            return result
        raise ValueError(f"Неожиданный токен: {token}")

    def parse_term(self):
        # разбирает 'терм': умножение и деление
        result = self.parse_factor()
        while self.current_token in ('*', '/'):
            op = self.current_token
            self.next_token()
            right_node = self.parse_factor()
            if op == '*':
                result *= right_node
            elif op == '/':
                if right_node == 0:
                    raise ZeroDivisionError("Деление на ноль.")
                result /= right_node
        return result

    def parse_expression(self):
        # разбирает 'выражение': сложение и вычитание
        result = self.parse_term()
        while self.current_token in ('+', '-'):
            op = self.current_token
            self.next_token()
            right_node = self.parse_term()
            if op == '+':
                result += right_node
            elif op == '-':
                result -= right_node
        return result

# основная функция с применением парсера
def evaluate_arithmetic_expressions(s):
    if not s.endswith('='):
        return "Ошибка: выражение не заканчивается на '='."
    expr = s[:]
    if not is_valid_brackets(expr):
        return "Ошибка: скобки расставлены неверно."

    tokens = tokenize(expr)
    if not tokens:
        raise ValueError("Пустое выражение.")
    parser = RecursiveParser(tokens)
    result = parser.parse_expression()
    if int(result) == result:
        result = int(result)
    return f"Результат: {result}"


print("Введите выражение: ")
a = input()
print(evaluate_arithmetic_expressions(a))

