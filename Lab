import re

# Хеш-функция та же
def simple_hash(word, table_size):
    return sum(ord(char) for char in word) % table_size

# Вставка в список
def insert_with_chaining(table, word):
    index = simple_hash(word, len(table))
    if word not in table[index]:
        table[index].append(word)

# Основная функция
def build_hash_table_with_chaining(text):
    words = re.findall(r'\b\w+\b', text.lower())
    table_size = len(words) // 2 + 1  # меньше, т.к. списки
    table = [[] for _ in range(table_size)]
    for word in words:
        insert_with_chaining(table, word)
    return table

# Чтение и запись
with open("input.txt", "r", encoding="utf-8") as f:
    text = f.read()

table = build_hash_table_with_chaining(text)

with open("output_lab14.txt", "w", encoding="utf-8") as f:
    for i, bucket in enumerate(table):
        f.write(f"{i}: {bucket}\n")

