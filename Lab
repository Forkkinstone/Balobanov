def calculate(x):
    answers = []
    for i in range(1, x + 1):
        temp = i
        while temp % 3 == 0: temp //= 3
        while temp % 5 == 0: temp //= 5
        while temp % 7 == 0: temp //= 7
        if temp == 1:
            answers.append(i)

    return answers


num = int(input('Введите число x: '))
print(calculate(num))


