def is_valid(expr):
    #проверка скобок
    stack = []
    for char in expr:
        if char == '(':
            stack.append(char)
        elif char == ')':
            if not stack:
                return False
            stack.pop()
    return not stack

def safe_eval(expr):
    try:
        if not is_valid(expr):
            return "Ошибка: скобки расставлены неверно"
        if '/0' in expr.replace(' ', ''):
            return "Ошибка: деление на ноль"
        return eval(expr)
    except Exception:
        return "Ошибка: некорректное выражение"

